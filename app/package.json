    "rules": "node tools/rules.mjs",
    "bake": "node tools/bake.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
